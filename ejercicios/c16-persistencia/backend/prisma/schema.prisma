generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Libro {
  id          Int     @id @default(autoincrement())
  titulo      String
  autor       String
  precio      String
  imagen      String
  descripcion String
  destacado   Boolean @default(false)
  disponible  Boolean @default(true)
}

model Autor {
  id           Int    @id @default(autoincrement())
  nombre       String
  nacionalidad String
}
