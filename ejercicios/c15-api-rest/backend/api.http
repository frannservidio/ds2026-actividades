@baseUrl = http://localhost:3000/api

### 1. Listar libros
GET {{baseUrl}}/libros

### 2. Obtener un libro
GET {{baseUrl}}/libros/1

### 3. Crear un libro
POST {{baseUrl}}/libros
Content-Type: application/json

{
  "titulo": "Rayuela",
  "autor": "Julio Cortazar",
  "precio": "$18.000",
  "imagen": "https://ejemplo.com/rayuela.jpg",
  "descripcion": "Una novela fundamental de la literatura argentina.",
  "destacado": false,
  "disponible": true
}

### 4. Actualizar un libro
PUT {{baseUrl}}/libros/1
Content-Type: application/json

{
  "precio": "$16.500",
  "disponible": false
}

### 5. Eliminar un libro
DELETE {{baseUrl}}/libros/2

### 6. Libro inexistente - 404
GET {{baseUrl}}/libros/999

### 7. Listar autores
GET {{baseUrl}}/autores

### 8. Obtener un autor
GET {{baseUrl}}/autores/1

### 9. Crear un autor
POST {{baseUrl}}/autores
Content-Type: application/json

{
  "nombre": "Julio Cortazar",
  "nacionalidad": "Argentina"
}

### 10. Actualizar un autor
PUT {{baseUrl}}/autores/1
Content-Type: application/json

{
  "nacionalidad": "Estadounidense"
}

### 11. Eliminar un autor
DELETE {{baseUrl}}/autores/3

### 12. Autor inexistente - 404
GET {{baseUrl}}/autores/999
